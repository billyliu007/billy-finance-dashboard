PORT=4000
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_SSL=true
# Optional: max clients in the pg pool (default 10). Lower if you use Neon free tier or many app instances.
# PGPOOL_MAX=5
FRONTEND_BASE_URL=http://localhost:5173

AUTH_SESSION_TTL_MS=1209600000

# Required in production: secret used to hash Personal Access Tokens (API). Use a long random string.
# API_TOKEN_PEPPER=replace_with_secure_random_value

GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

SNAPSHOT_CRON_TOKEN=replace_with_secure_random_value

FX_PROVIDER=frankfurter
# Secondary FX when Frankfurter is incomplete or down (open.er-api, no key). Use none to disable.
FX_PROVIDER_FALLBACK=open.er-api
CRYPTO_PROVIDER=coinbase
FINNHUB_API_KEY=your_finnhub_api_key

# Debug: log per-step what-if scenario timing to server logs
# WHATIF_TIMING_LOG=true

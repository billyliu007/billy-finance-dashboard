PORT=4000
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_SSL=true
DATA_SOURCE=db
FRONTEND_BASE_URL=http://localhost:5173

AUTH_SESSION_TTL_MS=1209600000

GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_CALLBACK_URL=http://localhost:4000/api/auth/wechat/callback

SNAPSHOT_CRON_TOKEN=replace_with_secure_random_value
MIGRATION_BIND_ENABLED=true

FX_PROVIDER=frankfurter
CRYPTO_PROVIDER=coinbase
FINNHUB_API_KEY=your_finnhub_api_key
